option "title" "Liabilities, carried"
option "operating_currency" "USD"

; A store card carried for months while the shopping keeps landing on
; it: what the balance is made of and since when, what each part has
; cost, whether the payments are outrunning the charges, and how much
; cash is really spare to throw at it. The card charges 2% a month on
; the first; the shopping lands on the tenth; 300 goes off on the
; twentieth. Salary on the first, rent on the second, both in cash.

2026-01-01 open Assets:Checking               USD
2026-01-01 open Liabilities:Card:Store        USD
  name: "Store Card"
2026-01-01 open Expenses:Financial:Interest   USD
2026-01-01 open Expenses:Food:Groceries       USD
  name: "Groceries"
2026-01-01 open Expenses:Home:Furnishing      USD
  name: "Furnishing"
2026-01-01 open Expenses:Home:Rent            USD
2026-01-01 open Income:Salary                 USD
2026-01-01 open Equity:Opening                USD

2026-01-01 * "opening"
  Assets:Checking                          6000.00 USD
  Equity:Opening

; ---- January: a sofa and the shopping ----

2026-01-01 * "Acme" "salary"
  Income:Salary                           -4000.00 USD
  Assets:Checking

2026-01-02 * "Landlord" "rent"
  Expenses:Home:Rent                       1500.00 USD
  Assets:Checking

2026-01-10 * "sofa"
  Expenses:Home:Furnishing                 1200.00 USD
  Liabilities:Card:Store

2026-01-15 * "groceries"
  Expenses:Food:Groceries                   150.00 USD
  Liabilities:Card:Store

2026-01-20 * "card payment"
  Liabilities:Card:Store                    300.00 USD
  Assets:Checking

