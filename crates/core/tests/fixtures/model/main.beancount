option "title" "Model Ledger"
option "operating_currency" "USD"

; VEA says what it is; VACHR is declared and silent; nothing declares
; the currencies at all.
2025-11-01 commodity VEA
  name: "Vanguard FTSE Developed Markets ETF"
  asset-class: "etf"
  quote-currency: "USD"
2025-11-01 commodity VACHR

2025-11-01 open Assets:Cash                 USD
2025-11-01 open Assets:US:BofA:Checking     USD
  name: "Checking"
2025-11-01 open Assets:ETrade:VEA           VEA
2025-11-01 open Assets:Vault                USD
  ynab: "tracking"
2025-11-01 open Assets:Old                  USD
  ynab: "hidden"
2025-11-01 open Assets:Points               VACHR
2025-11-01 open Liabilities:US:Chase:Slate  USD
2025-11-01 open Income:Salary               USD
2025-11-01 open Expenses:Home:Rent          USD
  name: "Monthly Rent"
2025-11-01 open Expenses:Food:Groceries     USD
2025-11-01 open Expenses:Fun:Games          USD
2025-11-01 open Expenses:Food:Dining:Coffee
2025-11-01 open Expenses:Vacation

