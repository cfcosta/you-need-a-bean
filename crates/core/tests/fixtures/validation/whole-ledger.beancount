option "operating_currency" "USD"
2026-01-01 open Assets:Cash USD
  scope: "shared"
2026-01-01 open Assets:Business:Cash USD
2026-01-01 open Income:Salary USD
2026-01-01 open Income:Business:Consulting USD
2026-01-01 open Expenses:Food USD
2026-01-01 open Expenses:Business:Supplies USD
